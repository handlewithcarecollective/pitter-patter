{
  "name": "pitter-patter",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check:format": "oxfmt --check",
    "check:lint": "oxlint scripts/ packages/",
    "check:types": "tsgo --build .",
    "check:versions": "node scripts/checkVersions.mts",
    "check": "pnpm run check:format && pnpm run check:types && pnpm run check:lint && pnpm run check:versions",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix scripts/ packages/",
    "fix": "pnpm run fix:format && pnpm run fix:lint",
    "demo:full": "pnpm run check:types && pnpm --filter @pitter-patter/demo run start",
    "dev:docs": "pnpm --filter @pitter-patter/docs run dev",
    "build:docs": "pnpm --filter @pitter-patter/docs run build",
    "test": "pnpm -r --if-present run test",
    "change:new": "pnpm change",
    "change:status": "pnpm change status",
    "release": "node scripts/bumpVersions.mts",
    "w": "./scripts/workspace-exec.sh"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "packageManager": "pnpm@12.3.4"
}
