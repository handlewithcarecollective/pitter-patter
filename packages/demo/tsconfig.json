{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedSideEffectImports": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react-jsx",
    "target": "ESNext"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../collab-client"
    },
    {
      "path": "../collab-server"
    },
    {
      "path": "../presence-client"
    },
    {
      "path": "../presence-server"
    },
    {
      "path": "../version-history-client"
    },
    {
      "path": "../version-history-server"
    }
  ]
}
