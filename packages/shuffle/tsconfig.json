{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "lib": ["es2023", "dom"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../refs"
    }
  ]
}
